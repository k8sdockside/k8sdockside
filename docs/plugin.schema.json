{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://raw.githubusercontent.com/k8sdockside/k8sdockside/main/docs/plugin.schema.json",
    "title": "K8s Dockside plugin",
    "description": "A K8s Dockside solution plugin, or a pack of them. See docs/plugins.md. The app checks more than this schema can say (that kinds exist, that queries parse, that pages are in the ui folder): run plugincheck for the whole of it.",
    "if": {
        "type": "object",
        "required": [
            "plugins"
        ]
    },
    "then": {
        "$ref": "#/definitions/pack"
    },
    "else": {
        "$ref": "#/definitions/plugin"
    },
    "definitions": {
        "pack": {
            "type": "object",
            "description": "Several plugins in one file.",
            "additionalProperties": false,
            "required": [
                "plugins"
            ],
            "properties": {
                "$schema": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "author": {
                    "type": "string",
                    "maxLength": 80,
                    "description": "Who wrote the pack. Given to every plugin in it that names no author of its own."
                },
                "authorUrl": {
                    "type": "string",
                    "pattern": "^https?://[^\\s]+$",
                    "description": "Where to find the pack's author."
                },
                "version": {
                    "type": "string"
                },
                "plugins": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/plugin"
                    }
                }
            }
        },
        "plugin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id"
            ],
            "properties": {
                "$schema": {
                    "type": "string",
                    "description": "Where an editor finds this schema. Ignored by the app."
                },
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$",
                    "description": "Stable id: lowercase letters, digits and dashes. Saved tabs are found by it."
                },
                "name": {
                    "type": "string",
                    "description": "Shown in the sidebar. Defaults to the id."
                },
                "tagline": {
                    "type": "string"
                },
                "category": {
                    "type": "string",
                    "enum": [
                        "storage",
                        "cni",
                        "networking",
                        "security",
                        "images",
                        "observability",
                        "delivery",
                        "virtualization",
                        "cost",
                        "platform",
                        "other"
                    ],
                    "description": "What the plugin is about, in one word. The settings view groups and filters by it. Left out, it is \"other\"."
                },
                "icon": {
                    "type": "string",
                    "enum": [
                        "dashboard",
                        "server",
                        "layers",
                        "bell",
                        "box",
                        "rocket",
                        "database",
                        "repeat",
                        "check",
                        "clock",
                        "share",
                        "globe",
                        "sliders",
                        "lock",
                        "unlock",
                        "play",
                        "pause",
                        "stop",
                        "power",
                        "drive",
                        "gateway",
                        "route",
                        "grant",
                        "puzzle",
                        "terminal",
                        "bug",
                        "forward",
                        "chevron-left",
                        "chevron-right",
                        "chevron-down",
                        "copies",
                        "copy",
                        "tick",
                        "scale",
                        "gauge",
                        "shield",
                        "priority",
                        "chip",
                        "webhook",
                        "policy",
                        "history",
                        "certificate",
                        "exit",
                        "link",
                        "graph",
                        "user",
                        "users",
                        "helm",
                        "refresh",
                        "download",
                        "expand-all",
                        "collapse-all",
                        "sort-asc",
                        "sort-desc",
                        "sort-off",
                        "plus",
                        "minus",
                        "folder-plus",
                        "folder",
                        "close",
                        "menu",
                        "dot",
                        "edit",
                        "save",
                        "chevron-up",
                        "alert",
                        "file",
                        "search",
                        "trash",
                        "undo",
                        "dock-right",
                        "dock-bottom",
                        "dock-left",
                        "pin",
                        "settings",
                        "sun",
                        "moon",
                        "monitor",
                        "display",
                        "rows",
                        "columns",
                        "type",
                        "restore",
                        "image",
                        "info",
                        "help",
                        "book"
                    ],
                    "description": "One of the app's icons."
                },
                "logo": {
                    "type": "string",
                    "description": "The plugin's own mark, a file in its ui folder (e.g. \"logo.svg\"). Shown wherever the app names the plugin, in place of `icon`. SVG, PNG or WebP.",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*\\.(svg|png|webp)$"
                },
                "author": {
                    "type": "string",
                    "maxLength": 80,
                    "description": "Who wrote the plugin, a person or a company. Credited wherever the app shows the plugin."
                },
                "authorUrl": {
                    "type": "string",
                    "pattern": "^https?://[^\\s]+$",
                    "description": "Where to find the author: a profile, a company site. The author's name links to it. Needs author."
                },
                "version": {
                    "type": "string",
                    "pattern": "^v?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
                    "description": "The plugin's own version, e.g. 1.0.0."
                },
                "minAppVersion": {
                    "type": "string",
                    "pattern": "^v?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$",
                    "description": "The oldest K8s Dockside release the plugin works with, e.g. 0.0.15. An older app refuses the plugin and says so."
                },
                "docs": {
                    "type": "string",
                    "pattern": "^https?://[^\\s]+$",
                    "description": "A documentation link shown on the overview."
                },
                "links": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                        "$ref": "#/definitions/link"
                    },
                    "description": "What the plugin is about: the product's site, its source."
                },
                "description": {
                    "type": "string"
                },
                "requires": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/requirement"
                    }
                },
                "views": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/view"
                    }
                },
                "cards": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/card"
                    }
                },
                "charts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/chart"
                    }
                },
                "usage": {
                    "$ref": "#/definitions/usage"
                },
                "ui": {
                    "$ref": "#/definitions/ui"
                },
                "actions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/action"
                    }
                },
                "sections": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/section"
                    }
                },
                "overview": {
                    "$ref": "#/definitions/overview"
                }
            }
        },
        "link": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "url"
            ],
            "properties": {
                "label": {
                    "type": "string",
                    "description": "Defaults to the address's host."
                },
                "url": {
                    "type": "string",
                    "pattern": "^https?://[^\\s]+$"
                }
            }
        },
        "requirement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "kind"
            ],
            "properties": {
                "kind": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A kind the app can open: a built-in name such as \"deployments\", or \"crd:<plural>.<group>\" for a custom resource."
                },
                "label": {
                    "type": "string"
                },
                "optional": {
                    "type": "boolean",
                    "description": "Reported, but does not decide whether the solution counts as installed."
                },
                "namespace": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
                    "description": "With selector: the namespace to look in. Every namespace without it."
                },
                "selector": {
                    "type": "string",
                    "description": "Turns \"the cluster serves this kind\" into \"the cluster has these objects\": a label selector the requirement is met only if something matches. For a product that defines no custom resources, e.g. \"app=flannel\" on daemonsets. Costs one list."
                }
            }
        },
        "view": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$",
                    "not": {
                        "const": "overview"
                    }
                },
                "label": {
                    "type": "string"
                },
                "icon": {
                    "type": "string",
                    "enum": [
                        "dashboard",
                        "server",
                        "layers",
                        "bell",
                        "box",
                        "rocket",
                        "database",
                        "repeat",
                        "check",
                        "clock",
                        "share",
                        "globe",
                        "sliders",
                        "lock",
                        "unlock",
                        "play",
                        "pause",
                        "stop",
                        "power",
                        "drive",
                        "gateway",
                        "route",
                        "grant",
                        "puzzle",
                        "terminal",
                        "bug",
                        "forward",
                        "chevron-left",
                        "chevron-right",
                        "chevron-down",
                        "copies",
                        "copy",
                        "tick",
                        "scale",
                        "gauge",
                        "shield",
                        "priority",
                        "chip",
                        "webhook",
                        "policy",
                        "history",
                        "certificate",
                        "exit",
                        "link",
                        "graph",
                        "user",
                        "users",
                        "helm",
                        "refresh",
                        "download",
                        "expand-all",
                        "collapse-all",
                        "sort-asc",
                        "sort-desc",
                        "sort-off",
                        "plus",
                        "minus",
                        "folder-plus",
                        "folder",
                        "close",
                        "menu",
                        "dot",
                        "edit",
                        "save",
                        "chevron-up",
                        "alert",
                        "file",
                        "search",
                        "trash",
                        "undo",
                        "dock-right",
                        "dock-bottom",
                        "dock-left",
                        "pin",
                        "settings",
                        "sun",
                        "moon",
                        "monitor",
                        "display",
                        "rows",
                        "columns",
                        "type",
                        "restore",
                        "image",
                        "info",
                        "help",
                        "book"
                    ],
                    "description": "One of the app's icons."
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "table",
                        "custom"
                    ],
                    "description": "table (the default) lists a kind; custom opens a page of the plugin's own."
                },
                "kind": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A kind the app can open: a built-in name such as \"deployments\", or \"crd:<plural>.<group>\" for a custom resource."
                },
                "entry": {
                    "type": "string",
                    "pattern": "\\.html?$",
                    "description": "A page inside the plugin's ui folder, e.g. index.html."
                },
                "namespace": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
                    "description": "Pins to one namespace."
                },
                "selector": {
                    "type": "string",
                    "description": "A label selector in the usual a=b,c in (d,e) syntax."
                },
                "focus": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "kind"
                    ],
                    "description": "Custom views only: lets the app open this view on one object of a kind -- from a search hit, for instance -- by putting the object in the page's address after the #.",
                    "properties": {
                        "kind": {
                            "type": "string",
                            "minLength": 1,
                            "description": "The kind the view can be opened on: a built-in name, or \"crd:<plural>.<group>\"."
                        },
                        "hash": {
                            "type": "string",
                            "description": "What follows the # in the page's address. {namespace} and {name} are replaced by the object's, URL-encoded. Defaults to namespace={namespace}&name={name}."
                        }
                    }
                }
            }
        },
        "card": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "kind"
            ],
            "properties": {
                "label": {
                    "type": "string"
                },
                "kind": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A kind the app can open: a built-in name such as \"deployments\", or \"crd:<plural>.<group>\" for a custom resource."
                },
                "groupBy": {
                    "type": "string",
                    "description": "A field path: status.health.status, or status.conditions[Ready] for a condition's status."
                },
                "tones": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string",
                        "enum": [
                            "ok",
                            "warn",
                            "error",
                            "info"
                        ]
                    }
                },
                "namespace": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$",
                    "description": "Pins to one namespace."
                },
                "selector": {
                    "type": "string",
                    "description": "A label selector in the usual a=b,c in (d,e) syntax."
                }
            }
        },
        "chart": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "attach",
                "query"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                },
                "label": {
                    "type": "string"
                },
                "attach": {
                    "type": "string",
                    "description": "\"dashboard\", \"overview\", or a kind whose detail panel draws it."
                },
                "query": {
                    "type": "string",
                    "description": "PromQL. May use $namespace, $name and $node when attached to a kind."
                },
                "legend": {
                    "type": "string",
                    "description": "The Prometheus label each series is titled by."
                },
                "unit": {
                    "type": "string",
                    "enum": [
                        "cores",
                        "bytes",
                        "bytes/s",
                        "percent",
                        "ops/s",
                        "seconds",
                        "count"
                    ]
                },
                "description": {
                    "type": "string"
                }
            }
        },
        "usagePair": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "cpu": {
                    "type": "string"
                },
                "memory": {
                    "type": "string"
                }
            }
        },
        "usage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "node": {
                    "$ref": "#/definitions/usagePair"
                },
                "pod": {
                    "$ref": "#/definitions/usagePair"
                }
            }
        },
        "ui": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "dir": {
                    "type": "string",
                    "description": "The folder the pages are read from, beside plugin.json. Defaults to ui."
                },
                "kinds": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "description": "A kind the app can open: a built-in name such as \"deployments\", or \"crd:<plural>.<group>\" for a custom resource."
                    },
                    "description": "Kinds the pages may read beyond those the plugin already names. Never secrets."
                },
                "write": {
                    "type": "boolean",
                    "description": "Lets the pages ask to merge-patch those kinds. Every patch is confirmed by the user."
                },
                "registries": {
                    "type": "boolean",
                    "description": "Lets the pages ask the registries of images the cluster runs which tags they have (k8sdockside.registry.lookup). The app asks, anonymously and over https; the pages still have no network access. Needs K8s Dockside 0.0.25 or newer."
                },
                "releases": {
                    "type": "array",
                    "maxItems": 10,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["github"],
                        "properties": {
                            "github": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9._-]{1,100}$",
                                "description": "A public GitHub repository, owner/repo: \"siderolabs/talos\"."
                            }
                        }
                    },
                    "description": "Public GitHub repositories whose release lists the pages may ask for (k8sdockside.releases). The app asks GitHub anonymously, keeps the answer for six hours, and only for the repositories named here; the user can switch it off. Needs K8s Dockside 0.1.33 or newer."
                },
                "tools": {
                    "type": "array",
                    "maxItems": 4,
                    "items": {
                        "$ref": "#/definitions/uiTool"
                    },
                    "description": "Command line tools on the user's machine the pages may run (k8sdockside.tools): the program, the files it reads (chosen by the user per cluster and passed by the app), and exactly which commands. 'read' commands run when a page asks; 'run' commands are shown to the user and run in a console in the dock only if they say yes; 'interactive' ones open in the user's own terminal. Desktop app only. Needs K8s Dockside 0.1.23 or newer."
                },
                "services": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                        "$ref": "#/definitions/uiService"
                    },
                    "description": "In-cluster Services the pages may make GET requests to (k8sdockside.services.get), through the API server's service proxy. The pages pick one of these and a path under its prefixes; nothing else. Needs K8s Dockside 0.0.27 or newer."
                }
            }
        },
        "uiTool": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "command"],
            "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$", "description": "What a page names the tool by." },
                "label": { "type": "string", "description": "How the app names it. Defaults to the command." },
                "command": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$", "description": "The program's name, looked for on PATH and where package managers put it. Never a path." },
                "version": { "type": "array", "items": { "type": "string" }, "description": "Arguments that make the tool print its version, e.g. [\"version\", \"--client\"]." },
                "files": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/uiToolFile" },
                    "description": "Files the tool reads, chosen by the user per cluster and passed to every command. Pages cannot choose the paths or pass the flags themselves."
                },
                "read": {
                    "type": "array",
                    "maxItems": 128,
                    "items": {
                        "oneOf": [
                            { "type": "string", "minLength": 1 },
                            { "$ref": "#/definitions/toolExtract" }
                        ]
                    },
                    "description": "Commands a page may run and read the output of, without asking. A pattern is words: a literal word, * for any one argument that is not a flag, and ** (last only) for whatever follows. An entry may instead be an extraction, { command, extract }: the app runs the command, parses its output itself and hands the page only the named scalar fields, never the output (0.1.33 and newer)."
                },
                "run": { "$ref": "#/definitions/toolPatterns", "description": "Commands a page may ask to run. The user sees the exact command line and it runs in a console in the dock only if they say yes." },
                "interactive": { "$ref": "#/definitions/toolPatterns", "description": "Commands a page may open in the user's own terminal, for ones that draw a full screen." }
            }
        },
        "uiToolFile": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
                "label": { "type": "string", "description": "What the file is called for a person, e.g. talosconfig." },
                "flag": { "type": "string", "description": "The flag that passes it, e.g. --talosconfig." },
                "env": { "type": "string", "description": "An environment variable that passes it as well, e.g. TALOSCONFIG." },
                "default": { "type": "string", "description": "Where it is when the user has not chosen one; ~ is their home." }
            }
        },
        "toolExtract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "extract"],
            "description": "A read whose output never reaches the page (k8sdockside.tools.extract): the app parses it and hands back only the named fields, each a string, number or true/false. No read, run or interactive pattern may match the same command -- the manifest is refused if one could. Needs K8s Dockside 0.1.33 or newer.",
            "properties": {
                "command": { "type": "string", "minLength": 1, "description": "A pattern, as in the other lists, e.g. \"get machineconfig **\"." },
                "extract": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["format", "fields"],
                    "properties": {
                        "format": {
                            "type": "string",
                            "enum": ["yaml-documents"],
                            "description": "yaml-documents: the output is YAML documents, each a resource with a spec -- a mapping, or text that is itself YAML documents (talosctl get ... -o yaml). The fields are looked for in each resource's spec; the first document that has one wins; the answer is one entry per resource, by its node."
                        },
                        "output": {
                            "type": "array",
                            "maxItems": 8,
                            "items": { "type": "string", "minLength": 1 },
                            "description": "Arguments the app adds after the page's own to fix the output format, e.g. [\"-o\", \"yaml\"]. The page may not give these flags, nor --."
                        },
                        "fields": {
                            "type": "array",
                            "minItems": 1,
                            "maxItems": 16,
                            "uniqueItems": true,
                            "items": {
                                "type": "string",
                                "maxLength": 200,
                                "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}(\\.[A-Za-z_][A-Za-z0-9_-]{0,63}){0,7}$"
                            },
                            "description": "Dotted paths, e.g. machine.install.image. Only a single value is handed back; a path that leads to a mapping or a list is refused."
                        }
                    }
                }
            }
        },
        "toolPatterns": {
            "type": "array",
            "maxItems": 128,
            "items": { "type": "string", "minLength": 1 }
        },
        "uiService": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "port",
                "paths"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
                    "description": "What the pages name the service by."
                },
                "label": {
                    "type": "string",
                    "maxLength": 60,
                    "description": "How the app names it on the plugin's card. Defaults to the service name."
                },
                "namespace": {
                    "type": "string",
                    "description": "Where the Service is. Required with name; with selector it narrows the search."
                },
                "name": {
                    "type": "string",
                    "description": "The Service's name. Give name or selector, not both."
                },
                "selector": {
                    "type": "string",
                    "description": "A label selector that finds the Service wherever it is installed. The first match with the port is used."
                },
                "port": {
                    "type": [
                        "string",
                        "integer"
                    ],
                    "description": "The Service port, by name or number."
                },
                "scheme": {
                    "type": "string",
                    "enum": [
                        "http",
                        "https"
                    ],
                    "description": "How the API server reaches the Service. Defaults to http."
                },
                "paths": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "pattern": "^/"
                    },
                    "description": "Path prefixes the pages may request, each a whole number of segments: \"/api\" allows /api/flows, not /apikeys."
                }
            }
        },
        "condition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "field"
            ],
            "properties": {
